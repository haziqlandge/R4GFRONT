# Secrets
.env
.env.local

# Machine-generated, per-box. scripts/00_detect_system.py. Never committed - three
# machines writing to the same tracked file would fight over whose specs "win".
LOCAL_SYSTEM_INFO.md
LOCAL_SYSTEM_ADDITIONS.md

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
*.egg-info/

# Node
node_modules/
.next/
.vercel/

# Built artifacts (regenerated from slice_manifest.json).
# Must be artifacts/* not artifacts/ - git cannot un-ignore a file inside an
# ignored directory, and slice_manifest.json has to be committed (Rules.md 5).
artifacts/*
!artifacts/slice_manifest.json

# Data never goes in git
*.parquet
*.onnx
*.bin

# OS
.DS_Store
Thumbs.db
