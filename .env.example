# Copy to .env and fill in. .env is gitignored and must never be committed.
# Rules.md section 4: no API key ever reaches the browser. These live only in services/.

# Sarvam AI - speech to text. Used by services/stt_gateway only.
# Endpoint: saaras:v3-realtime. https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Groq - LLM fallback path only, never on the extractive fast path.
# Model: llama-3.3-70b-versatile. https://console.groq.com/keys
# NOTE: Groq's edge returns 403 "error code: 1010" (a Cloudflare fingerprint
# block) to default urllib/requests User-Agents. Set an explicit User-Agent on
# the client. It looks like an auth failure and is not one.
GROQ_API_KEY=

# Hugging Face - dataset download in scripts/00_download_dataset.py.
# OPTIONAL: the download works unauthenticated; a token only raises rate limits.
# Use a READ token. We only read a public dataset, and a leaked write token
# could modify your own HF repos.
HF_TOKEN=

# No quotes, no spaces around "=". Write KEY=value, not KEY= "value".

# Service URLs. Localhost for dev; deployed India-region URLs in production.
RAG_CORE_URL=http://localhost:8000
STT_GATEWAY_URL=ws://localhost:8001

# Frontend. Must be NEXT_PUBLIC_ to reach the browser; these are URLs, not secrets.
NEXT_PUBLIC_RAG_CORE_URL=http://localhost:8000
NEXT_PUBLIC_STT_GATEWAY_URL=ws://localhost:8001
